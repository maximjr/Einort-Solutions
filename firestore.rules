rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'njeirheinard@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin']
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'njeirheinard@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, action) {
      return (
        (action == 'create' ? 
          (data.keys().hasAll(['uid', 'email', 'createdAt', 'lastLogin', 'accountType', 'onboardingStatus']) && data.keys().size() >= 6 && data.keys().size() <= 8) : 
          true
        ) &&
        (data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid) &&
        (data.email is string && data.email.size() <= 256) &&
        (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128) &&
        (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1024) &&
        (data.accountType is string && data.accountType.size() <= 50) &&
        (data.onboardingStatus is string && data.onboardingStatus.size() <= 50)
      );
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming(), 'create') &&
        incoming().createdAt == request.time &&
        incoming().lastLogin == request.time;
        
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming(), 'update') &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin', 'accountType', 'onboardingStatus']) &&
        (
          !('lastLogin' in incoming().diff(existing()).affectedKeys()) || incoming().lastLogin == request.time
        );
        
      allow delete: if isSuperAdmin();
    }

    match /projectSubmissions/{submissionId} {
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
