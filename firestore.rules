rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Fetch User Role
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role Checks
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super_admin'] ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true);
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'super_admin';
    }

    // Inquiries Collection: Public submit, admin read/write
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'company']);
      allow read, update, delete: if isAdmin();
    }

    // Users Collection (RBAC Source of Truth)
    match /users/{userId} {
      // User can read their own profile, Admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can securely create their profile upon signup (requires auth, but document must not exist yet)
      // or Admins can create users
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Only admins can modify roles, users can only update their own safe details
      allow update: if isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'permissions', 'accountType']));
      
      allow delete: if isSuperAdmin();
    }

    // Projects / CRM / general protected collections
    match /projects/{projectId} {
      allow read: if isOwner(resource.data.get('userId', '')) || (isAuthenticated() && request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email) || isAdmin();
      allow create: if request.resource.data.get('userId', '') == 'unauthenticated' || isOwner(request.resource.data.get('userId', '')) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // Activity / Analytics
    match /activity/{activityId} {
      allow read: if isOwner(resource.data.get('userId', '')) || isAdmin();
      allow write: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }

    match /ledger/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /crm/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /analytics/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /notifications/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }
    match /clientActivity/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }
    match /consultDossiers/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }
    match /projectOrders/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }
    match /projectSubmissions/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }
    match /customProjects/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }
    match /submissions/{documentId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.get('userId', ''));
      allow create: if isAdmin() || isOwner(request.resource.data.get('userId', ''));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
