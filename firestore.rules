rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Secure Profile Role Checking
    function getRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : 'none';
    }

    function getIsAdminFlag() {
       return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin 
        : false;
    }

    function hasValidRole() {
      // Allow if token has custom claim OR if profile has valid role
      return (request.auth.token.role in ['client', 'admin', 'super_admin']) || 
             (getRole() in ['client', 'admin', 'super_admin']) ||
             getIsAdminFlag() == true;
    }
    
    // Role Checks
    function isAdmin() {
      return (request.auth.token.role in ['admin', 'super_admin']) || 
             getRole() in ['admin', 'super_admin'] || 
             getIsAdminFlag() == true;
    }
    
    function isSuperAdmin() {
      return request.auth.token.role == 'super_admin' || getRole() == 'super_admin';
    }

    // Inquiries Collection: Public submit, admin read/write
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'company']);
      allow read, update, delete: if isAdmin();
    }

    // Users Collection (RBAC Source of Truth)
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Users can securely create their profile upon signup
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Users can update their own non-privileged fields, Admins can update all
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'permissions', 'accountType'])));
      allow delete: if isSuperAdmin();
    }

    // Projects / CRM / general protected collections
    match /projects/{projectId} {
      allow read: if isAuthenticated() && hasValidRole() && (
                     resource.data.userId == request.auth.uid ||
                     (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
                     isAdmin()
                   );
      allow create: if isAuthenticated() && hasValidRole() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // Activity / Analytics
    match /activity/{activityId} {
      allow read: if isAuthenticated() && hasValidRole() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }

    match /ledger/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /crm/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /analytics/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /notifications/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /clientActivity/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /consultDossiers/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /projectOrders/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /projectSubmissions/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /customProjects/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /submissions/{documentId} {
      allow read, update, delete: if isAuthenticated() && hasValidRole() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && hasValidRole() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
