rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Auth Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Secure Profile Role Checking - Eager evaluation safe
    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role in ['admin', 'super_admin']) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') in ['admin', 'super_admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'super_admin')
      );
    }

    function isRole(targetRole) {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == targetRole) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == targetRole)
      );
    }

    // Inquiries Collection: Public submit, admin read/write
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'company']);
      allow read, update, delete: if isAdmin();
    }

    // Users Collection (RBAC Source of Truth)
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'permissions', 'accountType'])));
      allow delete: if isSuperAdmin();
    }

    // Projects / CRM / general protected collections
    match /projects/{projectId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (request.auth.token.get('email', null) != null && resource.data.get('email', '') == request.auth.token.email)
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
    
    // Activity / Analytics
    match /activity/{activityId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }

    match /ledger/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /crm/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /analytics/{documentId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    match /notifications/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /clientActivity/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /consultDossiers/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /projectOrders/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /projectSubmissions/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /customProjects/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }
    match /submissions/{documentId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
