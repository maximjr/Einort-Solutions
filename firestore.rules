rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
             ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role 
             : 'client';
    }

    function isAdmin() {
      return request.auth != null && getRole() in ['super_admin', 'admin', 'manager', 'developer', 'designer'];
    }

    function isSuperAdmin() {
      return request.auth != null && getRole() == 'super_admin';
    }

    // Global bypass for super_admin
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow read: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /projectSubmissions/{submissionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /customProjects/{projectId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /clientActivity/{activityId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /projects/{projectId} {
      allow create: if isAdmin();
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }
  }
}
