rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, action) {
      return (
        (action == 'create' ? 
          (data.keys().hasAll(['uid', 'email', 'createdAt', 'lastLogin', 'accountType', 'onboardingStatus']) && data.keys().size() >= 6 && data.keys().size() <= 9) : 
          true
        ) &&
        (data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid) &&
        (data.email is string && data.email.size() <= 256) &&
        (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128) &&
        (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1024) &&
        (data.get('phoneNumber', '') is string && data.get('phoneNumber', '').size() <= 20) &&
        (data.accountType is string && data.accountType.size() <= 50) &&
        (data.onboardingStatus is string && data.onboardingStatus.size() <= 50)
      );
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      
      allow create: if isSignedIn() && request.auth.uid == userId &&
        isValidId(userId) &&
        isValidUser(incoming(), 'create') &&
        incoming().createdAt == request.time &&
        incoming().lastLogin == request.time;
        
      allow update: if isSignedIn() && request.auth.uid == userId &&
        isValidId(userId);
        
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /projectSubmissions/{submissionId} {
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /customProjects/{projectId} {
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true; // Public or anonymous can submit leads
      allow read, update, delete: if isAdmin();
    }

    match /clientActivity/{activityId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }
  }
}
